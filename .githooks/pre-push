#!/usr/bin/env bash
# tumbuh-protect-branches
# Blocks direct pushes to protected branches. Push via a feature branch + PR instead.
# Emergency override (use sparingly): git push --no-verify
set -uo pipefail

PROTECTED='^(main|staging|development)$'

# git feeds pre-push one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
blocked=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  branch="${remote_ref#refs/heads/}"
  if [[ "$branch" =~ $PROTECTED ]]; then
    echo "" >&2
    echo "  ✖ Direct push to '$branch' is blocked." >&2
    echo "    Create a feature branch and open a PR instead:" >&2
    echo "      git switch -c feat/your-change && git push -u origin feat/your-change" >&2
    blocked=1
  fi
done

if [ "$blocked" -eq 1 ]; then
  echo "" >&2
  echo "    (emergency override: git push --no-verify)" >&2
  echo "" >&2
  exit 1
fi
exit 0
